# ══════════════════════════════════════════════════════════
#  量化潜伏系统 - 环境变量配置
#  复制本文件为 .env 并填入你的 API Keys
# ══════════════════════════════════════════════════════════

# ── 必需：数据源 ──
# Tushare API Token（用于获取股票日线数据）
# 注册获取: https://tushare.pro/register
TUSHARE_TOKEN=your_tushare_token_here

# ── 必需：推送通道 ──
# Server酱推送 Key（管理员，用于微信消息推送）
# 注册获取: https://sct.ftqq.com/
SERVERCHAN_KEY=your_serverchan_key_here

# Server酱推送 Key（内测组，可选）
SERVERCHAN_KEY_BETA=your_serverchan_beta_key_here

# ── 可选：GitHub Actions 手动触发 ──
# GitHub Personal Access Token（用于 trigger_push.py 触发工作流）
# 创建地址: https://github.com/settings/tokens
# 权限: 勾选 workflow（触发 GitHub Actions）
GITHUB_TOKEN=your_github_token_here

# GitHub 仓库名称（默认: Lishoulan/lianghua）
GITHUB_REPO=Lishoulan/lianghua

# ── 可选：微信公众号群发（订阅服务）──
# 微信公众号配置（用于群发推送给订阅用户）
# 注册: https://mp.weixin.qq.com/
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
# 服务器配置 Token（自定义，用于微信签名验证）
WECHAT_TOKEN=your_wechat_token
# 消息加解密 Key（自定义，用于微信消息加解密）
WECHAT_ENCODING_AES_KEY=your_wechat_encoding_aes_key

# ── 可选：用户管理（订阅服务）──
# Supabase配置（用于管理微信公众号订阅用户）
# 注册: https://supabase.com/
# 注意: 使用 service_role key（非 anon key），云函数需要完全访问权限
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_service_role_key

# ── 可选：推送网关认证 ──
# GitHub Actions 调用云函数推送接口的认证 Key（自定义）
# 云函数 push_handler 和 stats_handler 需要此 Key 认证
PUSH_API_KEY=your_custom_push_api_key

# ── 可选：运行模式 ──
# Docker 部署时使用：cron=定时扫描，server=HTTP推送网关
RUN_MODE=cron
